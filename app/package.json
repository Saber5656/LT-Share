{
  "name": "lt-share-on-x-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test:e2e": "playwright test",
    "build:worker": "npm run build && node scripts/build-worker.mjs && node scripts/validate-worker.mjs",
    "test:server": "node --test tests/server/*.test.mjs",
    "preview:worker": "node scripts/preview-worker.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "fake-indexeddb": "6.2.5",
    "typescript": "7.0.2",
    "vite": "8.1.3",
    "wrangler": "4.151.2"
  }
}
